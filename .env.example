EXPO_PUBLIC_AWS_REGION=eu-west-2
EXPO_PUBLIC_USER_POOL_CLIENT_ID=

# --- shell, for apps/api scripts (db:migrate, org:create)
AWS_REGION=eu-west-2
DB_NAME=lettly
DB_CLUSTER_ARN=
DB_ADMIN_SECRET_ARN=
DB_APP_SECRET_ARN=
USER_POOL_ID=
