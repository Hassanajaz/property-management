{
  "name": "lettly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "test": "npm test --workspace @lettly/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run web --workspace @lettly/mobile",
    "dev:mobile": "npm run start --workspace @lettly/mobile",
    "deploy": "npm run deploy --workspace @lettly/infra --",
    "build:web": "npm run build:web --workspace @lettly/mobile"
  },
  "engines": {
    "node": ">=22.6"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
